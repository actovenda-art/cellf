{
  "version": 2,
  "builds": [
    { "src": "api/team.mjs", "use": "@vercel/node" },
    { "src": "api/showcase.mjs", "use": "@vercel/node" },
    { "src": "api/health.mjs", "use": "@vercel/node" },
    { "src": "api/imei.mjs", "use": "@vercel/node" },
    { "src": "api/session.mjs", "use": "@vercel/node" },
    { "src": "api/state.mjs", "use": "@vercel/node" },
    { "src": "api/documents.mjs", "use": "@vercel/node" },
    { "src": "api/stripe.mjs", "use": "@vercel/node" },
    { "src": "api/stripe-webhook.mjs", "use": "@vercel/node" },
    { "src": "public/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/team", "dest": "/api/team.mjs" },
    { "src": "/api/showcase", "dest": "/api/showcase.mjs" },
    { "src": "/operations.js", "dest": "/public/operations.js" },
    { "src": "/api/health", "dest": "/api/health.mjs" },
    { "src": "/api/imei", "dest": "/api/imei.mjs" },
    { "src": "/api/session", "dest": "/api/session.mjs" },
    { "src": "/api/state", "dest": "/api/state.mjs" },
    { "src": "/api/documents", "dest": "/api/documents.mjs" },
    { "src": "/api/stripe", "dest": "/api/stripe.mjs" },
    { "src": "/api/stripe/webhook", "dest": "/api/stripe-webhook.mjs" },
    { "src": "/styles.css", "dest": "/public/styles.css" },
    { "src": "/app.js", "dest": "/public/app.js" },
    { "src": "/cellf-logo.png", "dest": "/public/cellf-logo.png" },
    { "src": "/cellf-logo-updated.png", "dest": "/public/cellf-logo-updated.png" },
    { "src": "/cellf-logo-brand.svg", "dest": "/public/cellf-logo-brand.svg", "headers": { "Content-Type": "image/svg+xml; charset=utf-8", "Cache-Control": "public, max-age=0, must-revalidate" } },
    { "src": "/cellf-mark.png", "dest": "/public/cellf-mark.png" },
    { "src": "/cellf-distorted-glass.svg", "dest": "/public/cellf-distorted-glass.svg", "headers": { "Content-Type": "image/svg+xml", "Cache-Control": "public, max-age=0, must-revalidate" } },
    { "src": "/manifest.webmanifest", "dest": "/public/manifest.webmanifest", "headers": { "Content-Type": "application/manifest+json; charset=utf-8", "Cache-Control": "public, max-age=0, must-revalidate" } },
    { "src": "/(favicon-32|apple-touch-icon|icon-192|icon-512)\\.png", "dest": "/public/$1.png", "headers": { "Content-Type": "image/png", "Cache-Control": "public, max-age=0, must-revalidate" } },
    { "src": "/.*", "dest": "/public/index.html" }
  ]
}
