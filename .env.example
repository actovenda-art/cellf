# Copie este arquivo para .env. Nunca publique chaves secretas ou senhas.
PORT=4173

# Supabase: os segredos abaixo são utilizados exclusivamente no servidor.
SUPABASE_URL=https://vqdnfpueytxoggcogsra.supabase.co
SUPABASE_SECRET_KEY=
# Alternativa para projetos que utilizam a chave service_role legada:
# SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STATE_ID=cellf-primary
SUPABASE_DOCUMENT_BUCKET=cellf-documents

# Configure o e-mail administrativo, um hash scrypt da senha e um segredo aleatório.
CELLF_ADMIN_EMAIL=
CELLF_APP_PASSWORD_HASH=
# Compatibilidade temporária com instalações antigas; prefira o hash acima.
# CELLF_APP_PASSWORD=
CELLF_AUTH_SECRET=

# Integração opcional com a consulta oficial de IMEI.
INFOSIMPLES_TOKEN=
INFOSIMPLES_ENDPOINT=https://api.infosimples.com/api/v2/consultas/anatel/celular-legal

# Stripe Checkout: chaves exclusivas do servidor. Nunca exponha STRIPE_SECRET_KEY no navegador.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
