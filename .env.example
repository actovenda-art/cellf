# Copie este arquivo para .env. Nunca publique chaves secretas ou senhas.
PORT=4173

# Supabase: os segredos abaixo são utilizados exclusivamente no servidor.
SUPABASE_URL=https://vqdnfpueytxoggcogsra.supabase.co
SUPABASE_SECRET_KEY=
# Alternativa para projetos que utilizam a chave service_role legada:
# SUPABASE_SERVICE_ROLE_KEY=
